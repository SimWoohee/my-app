{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run type-check)",
      "Bash(npm run format:*)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\""
          }
        ]
      }
    ]
  }
}
